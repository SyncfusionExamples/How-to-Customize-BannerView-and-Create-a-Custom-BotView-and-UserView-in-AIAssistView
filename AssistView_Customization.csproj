<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>AssistViewDemo</AssemblyName>
    <RootNamespace>AssistViewDemo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Asset\AI_Assist.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Asset\AI_Assist.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
	<PackageReference Include="Microsoft.SemanticKernel">
      <Version>1.72.0</Version>
    </PackageReference>
	<PackageReference Include="Syncfusion.Core.WinForms" Version="33.1.45" />
	<PackageReference Include="Syncfusion.Licensing" Version="33.1.45" />
	<PackageReference Include="Syncfusion.SfAIAssistView.WinForms" Version="33.1.45" />
	<PackageReference Include="Syncfusion.Shared.Base" Version="33.1.45" />
  </ItemGroup>
</Project>